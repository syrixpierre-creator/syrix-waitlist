# Port of the Node server (serves the site and /api). Render sets PORT itself.
PORT=8080
# MongoDB connection string (MongoDB Atlas: Database > Connect > Drivers). Required in production.
MONGODB_URI=mongodb+srv://hussainmitel_db_user:oBkzfFPuUwIG3h25@cluster0.amd3u8g.mongodb.net/
MONGODB_DB=syrix_waitlist
# Admin token for /api/admin/stats and /api/admin/export.csv. Generate one: openssl rand -hex 24
ADMIN_TOKEN=
# 1 behind Render / Nginx / Cloudflare so rate limits see the real visitor IP.
TRUST_PROXY=1
# Other sites allowed to post to /api/waitlist (comma separated).
ALLOWED_ORIGINS=https://syrix.chat
# Optional confirmation e-mail (nothing is sent when SMTP_HOST is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
