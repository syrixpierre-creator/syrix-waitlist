# Copy to .env (never commit .env). On Render, set these in the service's Environment instead.
# Port of the Node server (serves the site and /api). Render sets PORT itself.
PORT=8080
# MongoDB connection string (MongoDB Atlas: Database > Connect > Drivers). Required in production.
MONGODB_URI=
MONGODB_DB=syrix_waitlist
# Admin page https://<domain>/syrixadmin: this e-mail + this password (12 characters minimum).
ADMIN_EMAIL=syrixcompany@gmail.com
ADMIN_PASSWORD=
# Signs admin session cookies. Generate one: openssl rand -hex 32
SESSION_SECRET=
# Optional token for scripts (Authorization: Bearer ...) on /api/admin/*. Generate one: openssl rand -hex 24
ADMIN_TOKEN=
# 1 behind Render / Nginx / Cloudflare so rate limits see the real visitor IP.
TRUST_PROXY=1
# Other sites allowed to post to /api/waitlist (comma separated).
ALLOWED_ORIGINS=https://syrix.chat
# Optional confirmation e-mail (nothing is sent when SMTP_HOST is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
