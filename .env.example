# Port of the Node server (serves the site and /api).
PORT=8080
# Admin token for /api/admin/stats and /api/admin/export.csv. Generate one: openssl rand -hex 24
ADMIN_TOKEN=
# Storage: leave DATABASE_URL empty to use a SQLite file (VPS / Docker), or set a PostgreSQL URL (required on Vercel).
DATABASE_URL=
SQLITE_PATH=data/waitlist.db
# Set to 1 when running behind Nginx / Cloudflare so rate limits see the real visitor IP.
TRUST_PROXY=1
# Other sites allowed to post to /api/waitlist (comma separated), e.g. https://syrix.chat
ALLOWED_ORIGINS=
# Optional confirmation e-mail (nothing is sent when SMTP_HOST is empty).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
